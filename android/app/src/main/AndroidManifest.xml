<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for the app to reach the backend API + Action Cable. Flutter only adds this
         automatically to the debug/profile manifests, so release builds need it declared here. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="Carnevale"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android App Links (CARNEVALEB-74). Without this, the https links the backend already
                 serves — the password-reset email and a shared game-join link — open the phone's
                 browser rather than this app, which is where they are least useful.

                 autoVerify makes Android fetch https://<host>/.well-known/assetlinks.json for every
                 host below at install time, and enable the association only where a fingerprint
                 there matches this build's signing certificate. Verification is all-or-nothing
                 across the hosts in one filter, so only domains that actually serve that file
                 belong here — the sslip.io host is deliberately left out.

                 The data elements combine, so this claims {,www.}carnevale-app.com × {/join,
                 /reset-password, /new-game} — not a catch-all, which would swallow every other URL
                 on the domain including the card pages. Query strings play no part in path matching,
                 so "/join?code=…" matches "/join". Handled in lib/main.dart via app_links; the
                 activity is already singleTop, so a link arriving while the app runs is delivered
                 to the existing instance rather than starting a second one. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="carnevale-app.com"/>
                <data android:host="www.carnevale-app.com"/>
                <data android:path="/join"/>
                <data android:path="/reset-password"/>
                <data android:path="/new-game"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
